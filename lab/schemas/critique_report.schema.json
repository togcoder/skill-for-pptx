{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CritiqueReport",
  "description": "Dual-layer strict aesthetic & technical evaluation report for AI design artifacts.",
  "type": "object",
  "required": [
    "intent_id",
    "evaluated_artifact",
    "total_score",
    "verdict",
    "dimension_scores",
    "layer_3a_linter",
    "layer_3b_art_critic",
    "auto_fail_triggered",
    "actionable_fixes"
  ],
  "properties": {
    "intent_id": {
      "type": "string"
    },
    "evaluated_artifact": {
      "type": "string",
      "description": "Path to file being audited"
    },
    "total_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "REJECT"]
    },
    "dimension_scores": {
      "type": "object",
      "required": ["cognitive_intent", "grid_spatial", "typography", "color_contrast", "craftsmanship"],
      "properties": {
        "cognitive_intent": {"type": "number", "maximum": 25},
        "grid_spatial": {"type": "number", "maximum": 25},
        "typography": {"type": "number", "maximum": 20},
        "color_contrast": {"type": "number", "maximum": 15},
        "craftsmanship": {"type": "number", "maximum": 15}
      }
    },
    "layer_3a_linter": {
      "type": "object",
      "required": ["overlap_violations", "contrast_violations", "overflow_violations"],
      "properties": {
        "overlap_violations": {"type": "integer"},
        "contrast_violations": {"type": "integer"},
        "overflow_violations": {"type": "integer"}
      }
    },
    "layer_3b_art_critic": {
      "type": "object",
      "required": ["focal_point_clarity", "breathing_room_ratio", "color_accent_share"],
      "properties": {
        "focal_point_clarity": {"type": "string", "enum": ["sharp", "diffuse", "cluttered"]},
        "breathing_room_ratio": {"type": "number", "description": "Whitespace fraction (>= 0.35 ideal)"},
        "color_accent_share": {"type": "number", "description": "Accent color area fraction (<= 0.15 ideal)"}
      }
    },
    "auto_fail_triggered": {
      "type": "boolean"
    },
    "actionable_fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_code", "severity", "fix_instruction", "target_tool"],
        "properties": {
          "issue_code": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical_auto_fail", "warn", "note"]},
          "fix_instruction": {"type": "string"},
          "target_tool": {"type": "string"}
        }
      }
    }
  }
}
