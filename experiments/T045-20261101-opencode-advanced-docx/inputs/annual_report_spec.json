        {
          "type": "paragraph",
          "text": "Tốc độ tăng trưởng được mô tả bằng công thức:"
        },
        {
          "type": "equation",
          "latex": "g_t = \\frac{Y_t - Y_{t-1}}{Y_{t-1}} \\times 100",
          "caption": "Tốc độ tăng trưởng theo năm."
        },
        {
          "type": "paragraph",
          "text": "Chỉ số tổng hợp dùng trung bình có trọng số:"
        },
