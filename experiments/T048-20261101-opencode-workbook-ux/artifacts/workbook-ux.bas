Attribute VB_Name = "DashboardTools"
' T046 dashboard helper. Generated by Sheet Forge; review before production.
Option Explicit

Private Sub SetStatus(ByVal text As String)
    On Error Resume Next
    ThisWorkbook.Worksheets("Input").Range("B20").Value = text
End Sub

Public Sub RefreshDashboard()
    On Error GoTo Failed
    Application.ScreenUpdating = False
    If Not WorksheetExists("Dashboard") Then
        Err.Raise 5, , "Dashboard sheet missing"
    End If
    ' RefreshAll is safe with or without a PivotTable; calculate the model last.
    ThisWorkbook.RefreshAll
    Application.CalculateFullRebuild
    ThisWorkbook.Worksheets("Dashboard").Activate
    Application.ScreenUpdating = True
    SetStatus "Dashboard refreshed."
    Exit Sub
Failed:
    Application.ScreenUpdating = True
    SetStatus "Refresh failed: " & Err.Description
End Sub

Public Sub FilterAtRisk()
    Dim ws As Worksheet
    If Not WorksheetExists("Data") Then Exit Sub
    Set ws = ThisWorkbook.Worksheets("Data")
    If ws.AutoFilterMode Then ws.AutoFilterMode = False
    ws.Range("A1:K61").AutoFilter Field:=10, Criteria1:="At risk"
End Sub

Public Sub AddRecord()
    Dim wsIn As Worksheet, wsData As Worksheet
    Dim workstream As String, owner As String, status As String, priority As String
    Dim startDate As Variant, days As Variant, cost As Variant, benefit As Variant
    Dim lastRow As Long, nextRow As Long, nextId As String
    If Not WorksheetExists("Input") Or Not WorksheetExists("Data") Then Exit Sub
    Set wsIn = ThisWorkbook.Worksheets("Input")
    Set wsData = ThisWorkbook.Worksheets("Data")
    workstream = Trim(CStr(wsIn.Range("C6").Value))
    owner = Trim(CStr(wsIn.Range("F6").Value))
    startDate = wsIn.Range("C7").Value
    days = wsIn.Range("F7").Value
    cost = wsIn.Range("C8").Value
    benefit = wsIn.Range("F8").Value
    status = Trim(CStr(wsIn.Range("C9").Value))
    priority = Trim(CStr(wsIn.Range("F9").Value))

    If workstream = "" Or owner = "" Or status = "" Or priority = "" Then
        SetStatus "Chọn Workstream, Owner, Trạng thái và Ưu tiên."
        Exit Sub
    End If
    If Not IsDate(startDate) Then
        SetStatus "Ngày bắt đầu không hợp lệ."
        Exit Sub
    End If
    If Not IsNumeric(days) Then
        SetStatus "Số ngày phải là số."
        Exit Sub
    End If
    If CLng(days) < 1 Or CLng(days) > 365 Then
        SetStatus "Số ngày phải từ 1 đến 365."
        Exit Sub
    End If
    If Not IsNumeric(cost) Or Not IsNumeric(benefit) Then
        SetStatus "Chi phí và lợi ích phải là số."
        Exit Sub
    End If

    lastRow = wsData.Cells(wsData.Rows.Count, "A").End(xlUp).Row
    nextRow = lastRow + 1
    nextId = "T" & Format(lastRow, "000")
    wsData.Cells(nextRow, 1).Value = nextId
    wsData.Cells(nextRow, 2).Value = workstream
    wsData.Cells(nextRow, 3).Value = owner
    wsData.Cells(nextRow, 4).Value = CDate(startDate)
    wsData.Cells(nextRow, 5).Value = CDate(startDate) + CLng(days) - 1
    wsData.Cells(nextRow, 6).Value = CLng(days)
    wsData.Cells(nextRow, 7).Value = 0
    wsData.Cells(nextRow, 8).Value = CDbl(cost)
    wsData.Cells(nextRow, 9).Value = CDbl(benefit)
    wsData.Cells(nextRow, 10).Value = status
    wsData.Cells(nextRow, 11).Value = priority
    ClearForm
    Application.CalculateFullRebuild
    SetStatus "Đã thêm " & nextId & "."
End Sub

Public Sub ClearForm()
    Dim ws As Worksheet
    If Not WorksheetExists("Input") Then Exit Sub
    Set ws = ThisWorkbook.Worksheets("Input")
    ws.Range("C6").Value = ""
    ws.Range("F6").Value = ""
    ws.Range("C7").Value = Date
    ws.Range("F7").Value = 10
    ws.Range("C8").Value = 0
    ws.Range("F8").Value = 0
    ws.Range("C9").Value = "On track"
    ws.Range("F9").Value = "Medium"
End Sub

Private Function WorksheetExists(ByVal name As String) As Boolean
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(name)
    WorksheetExists = Not ws Is Nothing
    On Error GoTo 0
End Function
