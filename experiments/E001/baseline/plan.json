  "research_metadata": {
    "experiment": "E001",
    "variant": "baseline",
    "created_date": "2026-10-03",
    "frozen_prompt": "Tạo ba cảnh PowerPoint cho một triển lãm sáng tạo: bốn hình tròn màu tụ quanh một tâm, mở ra thành bốn mô-đun, rồi xếp thành một dòng hành trình. Cảm giác liền mạch, bố cục táo bạo, tất cả vẫn chỉnh sửa được. Mỗi mô-đun mang một từ: Imagine, Make, Share, Evolve.",
    "recipes": [
      "radial-rearrange",
      "persistent-anchor"
    ],
    "assumptions": [
      "Ba cảnh tương ứng ba slide 16:9, tiến slide bằng thao tác trình chiếu; mỗi chuyển tiếp dự kiến 1200 ms.",
      "Mỗi mô-đun giữ hình tròn cùng màu và một nhãn chữ; không cần đổi loại hình học để mở rộng thành mô-đun.",
      "Bố cục táo bạo dùng nền tối, bốn màu sáng, tiêu đề lớn và khoảng trống rõ; màu không biểu diễn dữ liệu đo lường.",
      "Các nhãn đặt giữa mô-đun; kiểu chữ cụ thể và căn giữa do bộ thực thi quyết định theo khả năng hỗ trợ.",
      "Tọa độ là tỷ lệ chiều rộng và chiều cao slide; kích thước ellipse đã hiệu chỉnh tỷ lệ 16:9 để hiển thị thành hình tròn.",
      "Không dùng opacity một phần, ảnh, video, biểu đồ, nhóm, đường cong easing tùy chỉnh hoặc animation trong slide."
    ],
    "mechanism": {
      "identity": "Mỗi hình và nhãn có một semantic id cùng morph_name !! duy nhất, giữ nguyên trong cả ba trạng thái. Numeric shape ID do renderer cấp riêng trên từng slide.",
      "layer_order": "Nền → đường nối → bốn hình tròn → dấu tâm → nhãn → tiêu đề. Đường nối giãn ra phía sau các hình ở cảnh cuối.",
      "spatial_rule": "Thứ tự hoành độ Imagine < Make < Share < Evolve được bảo toàn. Từ unfold tới journey, hoành độ không đổi; chỉ cao độ và kích thước thay đổi.",
      "anchor": "Dấu tâm 8 px giữ nguyên ở (640, 432) trên canvas 1280×720; đường nối mở quanh cùng vị trí này.",
      "masking": "Không dùng mặt nạ. Chồng lấp các hình ở gather là có chủ đích; các nhãn ở tâm từng hình và ở lớp trên.",
      "timing": "Hai Morph liền kề, mỗi lần 1200 ms. Kế hoạch không khẳng định easing, đường chuyển động hoặc playback đã được kiểm chứng."
    },
    "reference": {
      "url": "https://powerpointschool.com/free-animated-powerpoint-presentation-template/",
      "title": "Free Animated PowerPoint Presentation Template",
      "author": "PowerPoint School",
      "access_date": "2026-10-03",
      "evidence_available": [
        "Trang mô tả của tác giả đã đọc.",
        "Ảnh giới thiệu tĩnh liên kết trong trang đã xem."
      ],
      "observed_mechanism": "Tác giả mô tả dùng Morph giữa slide và lưu ý đưa các nhóm lên lớp trước khi thay tài nguyên. Ảnh tĩnh chỉ cung cấp bố cục, không chứng minh thời gian hay chuyển động.",
      "evidence_not_obtained": [
