Attribute VB_Name = "DashboardTools"
' T043 dashboard helper. Generated by Sheet Forge; review before production.
Option Explicit

Public Sub RefreshDashboard()
    On Error GoTo Failed
    Application.ScreenUpdating = False
    ThisWorkbook.RefreshAll
    Application.CalculateFullRebuild
    ThisWorkbook.Worksheets("Dashboard").Activate
    Application.ScreenUpdating = True
    MsgBox "Dashboard refreshed.", vbInformation
    Exit Sub
Failed:
    Application.ScreenUpdating = True
    MsgBox "Refresh failed: " & Err.Description, vbExclamation
End Sub

Public Sub FilterAtRisk()
    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets("Data")
    If ws.AutoFilterMode Then ws.AutoFilterMode = False
    ws.Range("A1:K61").AutoFilter Field:=10, Criteria1:="At risk"
End Sub
